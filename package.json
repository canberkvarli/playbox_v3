    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "_pinned-versions-note": "react-native-reanimated and @react-native-async-storage/async-storage are EXACT-pinned (no ~ or ^). Drift between JS and native binary causes silent runtime breakage (see April 2026 incident). If you bump either, do a full `npx expo prebuild --clean && npx expo run:ios` to rebuild the native side in lockstep.",
    "verify-native-versions": "node -e \"const p=require('./package.json').dependencies;const exact=k=>!/^[~^]/.test(p[k]);['react-native-reanimated','react-native-worklets','@react-native-async-storage/async-storage'].forEach(k=>{if(!exact(k))throw new Error(k+' must be exact-pinned, got '+p[k])});console.log('native deps OK')\""
  },
